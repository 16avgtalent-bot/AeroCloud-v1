// Скопируй в Config/Secrets.xcconfig и заполни.
// Файл Secrets.xcconfig добавлен в .gitignore.
//
// ВАЖНО: Telegram bot token сюда не кладём. Он живёт только
// в Cloudflare Worker secrets (wrangler secret put TELEGRAM_BOT_TOKEN).

DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Backend (Cloudflare Worker). Пустое значение = backend не настроен.
AEROCLOUD_BACKEND_URL = https:/$()/auth.aerocloud.app

// Provider client ids / keys (не секреты, но лучше не коммитить).
SPOTIFY_CLIENT_ID = your_spotify_client_id
SOUNDCLOUD_CLIENT_ID = your_soundcloud_client_id
LASTFM_API_KEY = your_lastfm_api_key
DEEZER_APP_ID = your_deezer_app_id

// Bot username без @.
TELEGRAM_BOT_USERNAME = AeroCloudBot
