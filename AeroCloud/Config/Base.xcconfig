// AeroCloud — базовые настройки.
// Секреты и team id живут в Config/Secrets.xcconfig (gitignored).

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
PRODUCT_BUNDLE_IDENTIFIER = app.aerocloud.ios
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
IPHONEOS_DEPLOYMENT_TARGET = 27.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ENABLE_USER_SCRIPT_SANDBOXING = YES

// development | production
APS_ENVIRONMENT = development

// `https:/$()/` — трюк xcconfig: `//` иначе считается комментарием.
AEROCLOUD_BACKEND_URL = https:/$()/auth.aerocloud.app
SPOTIFY_CLIENT_ID =
SOUNDCLOUD_CLIENT_ID =
LASTFM_API_KEY =
DEEZER_APP_ID =
TELEGRAM_BOT_USERNAME = AeroCloudBot

#include? "Secrets.xcconfig"
